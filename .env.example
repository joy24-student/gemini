# ─────────────────────────────────────────────────────────────────────────────
# Gemini Unofficial API — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Session Cookies (required) ─────────────────────────────────────────
# Extract from: gemini.google.com → DevTools → Application → Cookies
GEMINI_1PSID=your___Secure-1PSID_value_here
GEMINI_1PSIDTS=your___Secure-1PSIDTS_value_here

# ── Server Configuration ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
API_WORKERS=1
LOG_LEVEL=info

# ── API Key for server protection (optional) ──────────────────────────────────
# If set, all /v1/ requests must send: Authorization: Bearer <key>
# Leave empty to allow unauthenticated access (NOT recommended for public VPS)
# GEMINI_API_KEY=sk-my-secret-key

# ── Proxy (optional) ──────────────────────────────────────────────────────────
# HTTP_PROXY=http://user:pass@proxy.example.com:8080
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080
