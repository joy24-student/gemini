# ─────────────────────────────────────────────────────────────────────────────
# Gemini Unofficial API — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Single Account Session Cookies (Default) ───────────────────────────────
# Extract from: gemini.google.com → DevTools → Application → Cookies
GEMINI_1PSID=your___Secure-1PSID_value_here
GEMINI_1PSIDTS=your___Secure-1PSIDTS_value_here

# ── 2. Multi-Account Cookie Pool (Option A: JSON String in .env) ───────────────
# Load balance requests across multiple Google accounts with automatic failover
# GEMINI_COOKIES_JSON='[{"name": "Joy Primary Account", "__Secure-1PSID": "psid1...", "__Secure-1PSIDTS": "ts1..."}, {"name": "Work Account", "__Secure-1PSID": "psid2...", "__Secure-1PSIDTS": "ts2..."}]'

# ── 3. Multi-Account Cookie Pool (Option B: JSON File Path) ───────────────────
# GEMINI_COOKIE_POOL_PATH=/app/cookies_pool.json

# ── 4. Multi-Account Cookie Pool (Option C: Numbered Environment Variables) ──
# GEMINI_COOKIE_1_NAME=Joy Main Account
# GEMINI_COOKIE_1_PSID=g.a000mQh...
# GEMINI_COOKIE_1_PSIDTS=sidts-Cg...

# GEMINI_COOKIE_2_NAME=Work Account
# GEMINI_COOKIE_2_PSID=g.a000mQi...
# GEMINI_COOKIE_2_PSIDTS=sidts-Ch...

# ── Server Configuration ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
API_WORKERS=1
LOG_LEVEL=info

# ── API Key for server protection (optional) ──────────────────────────────────
# If set, all /v1/ requests must send: Authorization: Bearer <key>
# GEMINI_API_KEY=sk-my-secret-key
